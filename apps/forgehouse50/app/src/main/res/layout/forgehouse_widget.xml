<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="10dp">

    <!-- Top header: App title on left, pill day badge on right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ForgeHouse 50"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_secondary" />

        <TextView
            android:id="@+id/w_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_chip_bg"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:text="Day 1/50"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/widget_chip_text" />
    </LinearLayout>

    <!-- Reading assignment title -->
    <TextView
        android:id="@+id/w_assignment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="John 1–3"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/widget_text_primary" />

    <!-- Optional verse snippet (collapsed when empty to save space) -->
    <TextView
        android:id="@+id/w_verse"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:visibility="gone"
        android:textSize="11sp"
        android:textColor="@color/widget_text_secondary" />

    <!-- Expressive wavy progress indicator -->
    <ProgressBar
        android:id="@+id/w_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginTop="3dp"
        android:progressDrawable="@drawable/widget_progress_wavy"
        android:max="100"
        android:progress="0" />

    <TextView
        android:id="@+id/w_progress_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="0/260 chapters"
        android:textSize="10sp"
        android:textColor="@color/widget_text_secondary" />

    <!-- Compact pill action button row with generous bottom clearance -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="2dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/w_primary"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="38dp"
            android:background="@drawable/widget_btn_primary"
            android:text="Start Reading"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/widget_btn_primary_text" />

        <Button
            android:id="@+id/w_secondary"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_btn_secondary"
            android:visibility="gone"
            android:text="Reflect"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/widget_btn_secondary_text" />
    </LinearLayout>

</LinearLayout>
