<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="12dp">

    <!-- Top header: App title on left, pill day badge on right -->
    <RelativeLayout
        android:id="@+id/w_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">

        <TextView
            android:id="@+id/w_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/widget_chip_bg"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="Day 1/50"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/widget_chip_text" />

        <TextView
            android:id="@+id/w_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@id/w_day"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="ForgeHouse 50"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_secondary" />
    </RelativeLayout>

    <!-- Bottom Action Button Row: anchored permanently to the bottom, NEVER cropped (streak_reader_support_fix_v1 / Issue 2) -->
    <LinearLayout
        android:id="@+id/w_button_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/w_primary"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="34dp"
            android:minHeight="0dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:background="@drawable/widget_btn_primary"
            android:text="Start Reading"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/widget_btn_primary_text" />

        <Button
            android:id="@+id/w_secondary"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:minHeight="0dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:layout_marginStart="8dp"
            android:paddingHorizontal="12dp"
            android:background="@drawable/widget_btn_secondary"
            android:visibility="gone"
            android:text="Reflect"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/widget_btn_secondary_text" />
    </LinearLayout>

    <!-- Middle content: flexible LinearLayout bounded between Header and Button Row -->
    <LinearLayout
        android:id="@+id/w_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/w_header"
        android:layout_above="@id/w_button_row"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <!-- Reading assignment title -->
        <TextView
            android:id="@+id/w_assignment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="John 1–3"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_primary" />

        <!-- Optional verse snippet (collapsed when empty to save space) -->
        <TextView
            android:id="@+id/w_verse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:visibility="gone"
            android:textSize="10sp"
            android:textColor="@color/widget_text_secondary" />

        <!-- Supported native Material 3 progress bar -->
        <ProgressBar
            android:id="@+id/w_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="4dp"
            android:progressDrawable="@drawable/widget_progress"
            android:max="100"
            android:progress="0" />

        <TextView
            android:id="@+id/w_progress_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="0/260 chapters (0%)"
            android:textSize="9sp"
            android:textColor="@color/widget_text_secondary" />
    </LinearLayout>

</RelativeLayout>
